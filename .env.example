# ── 楽天ウェブサービス ───────────────────────────────
# https://webservice.rakuten.co.jp/app/create でアプリを登録して取得
RAKUTEN_APPLICATION_ID=
RAKUTEN_ACCESS_KEY=

# ── 楽天アフィリエイト ──────────────────────────────
# https://affiliate.rakuten.co.jp/ のアフィリエイトID（20桁の英数字）
RAKUTEN_AFFILIATE_ID=

# ── サイト設定 ─────────────────────────────────────
SITE_URL=https://haruki3140-stack.github.io
SITE_NAME=楽天ランキング速報
SITE_DESCRIPTION=楽天市場のリアルタイムランキングを毎日自動集計。値下がり・順位変動を追跡します。
SITE_AUTHOR=

# 認証情報が無くてもモックデータで一通り動かす（1 で有効）
MOCK=0
